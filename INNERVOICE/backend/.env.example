# =====================================================
# INNERVOICE BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and set your production values
# DO NOT commit real secrets (.env) to version control
# =====================================================

# Server Configuration
PORT=5000

# CORS Security (Comma-separated origins for production)
# Example: https://innervoice.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=innervoice
# Set DB_SSL=true or DB_SSL=required for Cloud MySQL (Aiven, AWS RDS, Railway)
DB_SSL=false

# Authentication Security (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Required for AI Chatbot, Insights, & Sentiment)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio SMS OTP Integration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email OTP Integration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
